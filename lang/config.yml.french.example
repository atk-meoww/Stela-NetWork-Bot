  URL: ""
  image: ""
#  thumbnail: ""
#  footer:
#    text: ""
#    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

# L'intégration qui est envoyée dans les DM d'un utilisateur lorsqu'un membre du personnel utilise la commande d'alerte dans son ticket
alertDMEmbed:
  enabled: false
  color: "#FF0000"
  title: "Notification de fermeture de ticket"
  description: "Votre ticket **#{ticketName}** sur **{server}** sera bientôt fermé si aucune réponse n'a été reçue." # Vous pouvez utiliser {ticketName} pour le nom du ticket, {server} pour le nom de votre serveur & \n pour une nouvelle ligne
  timestamp: false
  URL: ""
  image: ""
  thumbnail: ""
  footer:
    text: ""
    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

# L'intégration qui est envoyée dans les DM d'un utilisateur si son ticket a été fermé
closeDMEmbed:
  enabled: false
  color: "#FF0000"
  title: "Ticket Fermé"
  description: "Votre ticket **#{ticketName}** a été fermé par {user} dans **{server}**." # Vous pouvez utiliser {ticketName} pour le nom du ticket, {user} pour le nom de l'utilisateur qui a rouvert le ticket, {server} pour le nom de votre serveur & \n pour une nouvelle ligne
  timestamp: false
  URL: ""
  image: ""
  thumbnail: ""
  footer:
    text: ""
    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

# L'intégration qui est envoyée dans les DM d'un utilisateur si son ticket a été rouvert
reopenDMEmbed:
  enabled: false
  color: "#2FF200"
  title: "Ticket Réouvert"
  description: "Votre ticket **#{ticketName}** a été rouvert par {user} dans **{server}**." # Vous pouvez utiliser {ticketName} pour le nom du ticket, {user} pour le nom de l'utilisateur qui a rouvert le ticket, {server} pour le nom de votre serveur & \n pour une nouvelle ligne
  timestamp: false
  URL: ""
  image: ""
  thumbnail: ""
  footer:
    text: ""
