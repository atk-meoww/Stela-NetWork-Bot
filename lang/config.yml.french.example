# ==============================================
# Logs.txt Salon 
# ==============================================

# Cette section est destinée aux utilisateurs qui hébergent le bot dans un environnement limité sans accès en écriture à un fichier logs.txt.
# L'activation de l'option ci-dessous et l'ajout d'un identifiant de salon signifieront que le bot enverra à la place les erreurs qui étaient censées aller au fichier logs.txt dans ce salon.
# Veuillez vous assurer que l'ID que vous ajoutez ci-dessous est celui d'un salon privée et sécurisée, et non publique.. (RISQUE !!)

logsFileToChannel: false # False par défaut, sauf si vous en avez besoin, ne l'activez pas
logsFileChannelID: ""
