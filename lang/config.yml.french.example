# ==============================================
# Paramètres généraux du Bot de tickets
# ==============================================

rolesThatCanBlacklist: ["111111111111111111"] # Les identifiants des rôles du Staff sur votre serveur qui doivent avoir accès à ajouter et supprimer des membres de la blacklist (impossible de créer un ticket), par exemple ["000000000000000000", "111111111111111111"]
rolesOnBlacklist: [] # Les identifiants des rôles que le bot ajoutera la blacklist
blacklistCleanup: "120" # La durée en seconde que le bot actualise la blacklist (pour vérifier quel utilisateur/role a été ajouté/supprimé)
transcriptType: "HTML" # Le type de transcription peut être "HTML" ou "TXT"
reOpenStaffOnly: false # Lorsque cette option est activée, seuls les membres du Staff ayant des rôles de support peuvent rouvrir un ticket
closeStaffOnly: true # Lorsqu'il est activé, seuls les membres du Staff ayant des rôles de support peuvent utiliser le bouton de fermeture du ticket
deleteStaffOnly: true # Lorsqu'il est activé, seuls les membres du Staff ayant des rôles de support peuvent utiliser le bouton Supprimer le ticket. Il est recommandé de garder cette option activée, sauf si vous avez l'intention d'utiliser la fonctionnalité de tableau AllowRoles lors de la configuration des boutons dans la configuration.
commands_cooldown: "5" # Le temps de recharge des commandes en secondes
buttons_cooldown: "5" # Le temps de recharge des boutons en secondes
maxOpenTickets: "1" # Le nombre maximum de tickets ouverts qu'un utilisateur peut avoir en même temps
deleteTicketTime: "5" # Le temps en secondes avant qu'un ticket soit supprimé (après avoir cliqué sur le bouton Supprimer)
claimFeature: false # Activer ou désactiver le bouton/la fonctionnalité de réclamation de ticket (claim)
claimRename: false # Activez ou désactivez le rename d'un ticket en Category-USERNAME lorsqu'il est réclamé, il utilisera le nom d'utilisateur du Staff qui l'a réclamé.
claimRenameName: "{category}-{username}" # Le nouveau nom du ticket lorsqu'il est réclamé, les options sont: {category} pour la catégorie du ticket, {username} pour le nom d'utilisateur du Staff qui l'a réclamé, {displayname} pour le nom d'affichage/surnom du Staff
claim1on1: false # Lorsque cette fonctionnalité est activée, lors de la réclamation d'un ticket, seuls le créateur du ticket et le Staff qui a réclamé le ticket pourront y discuter.
status:
  botActivityText: "Assistance aux tickets" # Le message d'activité du bot
  botActivityType: "Watching" # Le type d'activité du bot peut être "Playing", "Streaming", "Listening", "Watching", "Competing"
  streamingOptionURL: "" # L'URL si vous utilisez l'option de streaming exemple : (hhtps://twitch.tv/VOTRECOMPTETWITCH)
  botStatus: "online" # Le statut du bot peut être "online", "idle", "dnd", "invisible", notez que le type de streaming nécessite le statut "online"
alertReply:
  enabled: false # Activez ou désactivez la réponse du robot après que la commande alert ait été effectuée
  time: "120" # La durée en secondes, évitez d'utiliser des valeurs trop élevées
  reply: "L'utilisateur a répondu à l'alerte et semble être disponible." # La réponse qui sera envoyée dans le ticket si le créateur du ticket est actif et a répondu
autoCloseTickets:
  enabled: false # Désactivés ou activés la fonctionnalité qui permet la fermeture automatique des tickets.
  interval: "60" # La durée en seconde pour que la fermeture automatique s'effectue.
  time: "86400" # La durée en secondes entre le dernier message du créateur du ticket et la fermeture automatique du ticket. Par exemple, si la valeur est 1 jour en secondes, le ticket sera fermé si le dernier message envoyé par le créateur du ticket date de 1 jour. L'heure par défaut est de 1 jour.
onUserLeave: "close" # L'action automatisée que le bot entreprendra lorsqu'un utilisateur quittera le serveur alors qu'un ticket est ouvert, peut être "close" ou "delete", ce qui fermera ou supprimera automatiquement son ticket, vous pouvez également le mettre sur "none" pour désactiver la automatisation.

# ==============================================
# Paramètres de catégorie de ticket
# ==============================================

# La limite fixée par Discord est de 25, bien qu'il soit fortement recommandé de ne pas utiliser un nombre aussi élevé de types étant donné que chaque type utilise 2 catégories et que la limite de Discord est de 50 catégories, vous n'aurez plus de catégories à utiliser pour vos salons Discord normales. ...
# Pour la section autorisations, les permissions possibles sont: ViewChannel, SendMessages, EmbedLinks, AttachFiles, ReadMessageHistory, ManageChannels, ManageWebhooks, CreateInstantInvite, CreatePrivateThreads, CreatePublicThreads, SendMessagesInThreads, AddReactions, UseExternalEmojis, UseExternalStickers, MentionEveryone, ManageMessages, ManageThreads, UseApplicationCommands, SendVoiceMessages, UseEmbeddedActivities, SendTTSMessages
# NOTE: Le bot devra peut-être recevoir des autorisations d'administrateur en fonction des autorisations que vous avez définies dans les catégories. Si vous obtenez une erreur de console indiquant « Autorisations manquantes », alors votre bot ne dispose pas d'autorisations.																																																	   
TicketCategories:
  - id: 1 # ID unique pour chaque catégorie, UTILISEZ UNIQUEMENT DES CHIFFRES (il est suggéré d'incrémenter simplement cette valeur de 1 à chaque fois)
    name: "report" # Le nom de la catégorie, il sera en minuscule de toute façon
    nameEmoji: "⌛️" # L'emoji du nom du nouveau ticket, "⌛️-report" dans ce cas ou laissez-le comme vide "" pour ne pas utiliser d'émoji.
    categoryID: ["111111111111111111"] # Les identifiants des catégories dans lesquelles ces tickets seront créés, par exemple ["000000000000000000", "111111111111111111"]
    closedCategoryID: ["111111111111111111"] # Les identifiants des catégories où iront les tickets clôturés, par exemple ["000000000000000000", "111111111111111111"]
    support_role_ids: ["000000000000000000", "111111111111111111"] # Les identifiants des rôles du Staff sur votre serveur qui peuvent accéder uniquement à cette catégorie de ticket, par exemple ["000000000000000000", "111111111111111111"]
    permissions: # Pour les autorisations de la catégorie, assurez-vous de ne jamais ajouter la même autorisation aux catégorie "Allow" et "Deny"
      ticketCreator:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"] # Le bot accordera ces autorisations au créateur du ticket dans un ticket ouvert
          deny: [] # Le bot refusera ces autorisations du créateur du ticket dans un ticket ouvert
        close:
          allow: [] # Le bot accordera ces autorisations au créateur du ticket dans un ticket fermé
          deny: ["SendMessages"] # Le bot refusera ces autorisations du créateur du ticket dans un ticket fermé
      supportRoles:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
      addedRoles:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
      addedUsers:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
    pingRoles: false # Activer ou désactiver la mention de rôle lorsqu'un ticket est ouvert dans cette catégorie
    ping_role_ids: [] # Les ID des rôles que vous souhaitez ping lorsqu'un ticket est ouvert dans cette catégorie, par exemple ["000000000000000000", "111111111111111111"]
    ghostPingRoles: false # Activez ou désactivez le ping fantôme sur "ping_role_ids" lorsqu'un ticket est ouvert, utilisez soit {support-roles} dans textContent ci-dessous ou cette option, évitez d'utiliser les deux car les rôles de support recevront alors 2 notifications.
    textContent: "" # Le contenu textuel envoyé avec l'intégration, utilisez {support-roles} pour les rôles de support uniquement si vous avez activé pingRoles ci-dessus, vous pouvez également utiliser {user} et {user.tag}
    creatorRoles: [] # Les ID des rôles pouvant créer des tickets dans cette catégorie, gardez-le vide pour permettre à tous les rôles de créer des tickets
    buttonEmoji: "👮" # L'emoji du bouton, laissez-le vide "" pour ne pas utiliser d'emojis
    buttonLabel: "Signaler un utilisateur" # Le nom du bouton
    buttonStyle: "Success" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"
    menuEmoji: "👮" # L'emoji de l'option de menu de sélection, laissez-le vide "" pour n'utiliser aucun emoji
    menuLabel: "Signaler un utilisateur" # Le nom de l'option de menu de sélection
    menuDescription: "Cliquez sur cette option pour ouvrir un ticket signalement d'utilisateur !" # La description de l'option de menu de sélection
    embedTitle: "Ticket de signalement" # Le titre de l'intégration
    color: "#FFD700" # La couleur d'intégration dans le ticket ouvert
    description: "Bienvenue {user} ({user.tag}) dans votre ticket de signalement ! Veuillez être patient pendant qu'un membre du Staff répond à votre signalement." # La description de l'embed dans le ticket créé, juste au dessus des champs de questions, utilise {user} pour l'utilisateur comme @User et {user.tag} pour le nom de l'utilisateur sans qu'il soit mentionné comme User
    ticketName: "TICKETCOUNT" # Options disponibless: USERNAME (sera comme name-USERNAME pour "report-ralphkb"), TICKETCOUNT (sera comme name-TICKETCOUNT pour "report-12348") or BOTH (sera comme USERNAME-TICKETCOUNT pour "ralphkb-12348")
    ticketTopic: "Créateur du ticket: {user} | Type de ticket: {type}" # La description du ticket (fonctionnalité Discord)
    slowmode: "0" # Le mode lent du canal ticket en secondes, gardez-le à 0 si vous ne souhaitez pas de mode lent et n'utilisez pas de valeurs négatives
    useCodeBlocks: false # Définissez ceci sur true si vous souhaitez utiliser des blocs de code pour afficher les réponses aux questions sur la catégorie de ticket
    modalTitle: "Formulaire de signalement" # Le titre du formulaire
    questions: # Le nombre maximum de questions est de 5, vous devez conserver au moins 1 question car cette information vous aidera toujours dans n'importe quel ticket.
      - label: "Quel est votre nom d'utilisateur?"
        placeholder: "Écrivez votre nom d'utilisateur"
        style: "Short" # Short or Paragraph
        required: true # Si cette question est obligatoire ou non, utilisez true pour oui ou false pour non
        minLength: 3 # Définir le nombre minimum de caractères requis pour la réponse
      - label: "Nom d'utilisateur de(s) personne(s) a signalée(s)?"
        placeholder: "Écrivez leur nom d'utilisateur"
        style: "Short"
        required: true
        minLength: 3
      - label: "Pourquoi le(s) signaler(ez-vous) ?"
        placeholder: "Expliquez avec des détails"
        style: "Paragraph"
        required: true
        minLength: 50
  - id: 2 # ID unique pour chaque catégorie
    name: "Divers" # Le nom de la catégorie, il sera en minuscule de toute façon
    nameEmoji: "❓" # L'emoji du nom du nouveau ticket, "❓-divers" dans ce cas ou laissez-le comme vide "" pour ne pas utiliser d'émoji.
    categoryID: ["111111111111111111"] # Les identifiants des catégories dans lesquelles ces tickets seront créés, par exemple ["000000000000000000", "111111111111111111"]
    closedCategoryID: ["111111111111111111"] # Les identifiants des catégories où iront les tickets clôturés, par exemple ["000000000000000000", "111111111111111111"]
    support_role_ids: ["000000000000000000", "111111111111111111"] # Les identifiants des rôles du Staff sur votre serveur qui peuvent accéder uniquement à cette catégorie de ticket, par exemple ["000000000000000000", "111111111111111111"]
    permissions: # Pour les autorisations de la catégorie, assurez-vous de ne jamais ajouter la même autorisation aux catégorie "Allow" et "Deny"
      ticketCreator:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"] # Le bot accordera ces autorisations au créateur du ticket dans un ticket ouvert
          deny: [] # Le bot refusera ces autorisations du créateur du ticket dans un ticket ouvert
        close:
          allow: [] # Le bot accordera ces autorisations au créateur du ticket dans un ticket fermé
          deny: ["SendMessages"] # Le bot refusera ces autorisations du créateur du ticket dans un ticket fermé
      supportRoles:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
      addedRoles:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
      addedUsers:
        open:
          allow: ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "ReadMessageHistory"]
          deny: []
        close:
          allow: []
          deny: ["SendMessages"]
    pingRoles: false # Activer ou désactiver la mention de rôle lorsqu'un ticket est ouvert dans cette catégorie
    ping_role_ids: [] # Les ID des rôles que vous souhaitez ping lorsqu'un ticket est ouvert dans cette catégorie, par exemple ["000000000000000000", "111111111111111111"]
    ghostPingRoles: false # Activez ou désactivez le ping fantôme sur "ping_role_ids" lorsqu'un ticket est ouvert, utilisez soit {support-roles} dans textContent ci-dessous ou cette option, évitez d'utiliser les deux car les rôles de support recevront alors 2 notifications.
    textContent: "" # Le contenu textuel envoyé avec l'intégration, utilisez {support-roles} pour les rôles de support uniquement si vous avez activé pingRoles ci-dessus, vous pouvez également utiliser {user} et {user.tag}
    creatorRoles: [] # Les ID des rôles pouvant créer des tickets dans cette catégorie, gardez-le vide pour permettre à tous les rôles de créer des tickets
    buttonEmoji: "❓" # L'emoji du bouton, laissez-le vide "" pour ne pas utiliser d'emojis
    buttonLabel: "Divers" # The name of the button
    buttonStyle: "Primary" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"
    menuEmoji: "❓" # L'emoji de l'option de menu de sélection, laissez-le vide "" pour n'utiliser aucun emoji
    menuLabel: "Divers" # Le nom de l'option de menu de sélection
    menuDescription: "Cliquez sur cette option pour ouvrir un ticket divers !" # La description de l'option de menu de sélection
    embedTitle: "Ticket Divers" # Le titre de l'intégration
    color: "#ADD8E6" # La couleur d'intégration dans le ticket ouvert
    description: "Bienvenue {user} ({user.tag}) dans votre ticket! Veuillez patienter pendant qu'un membre du Staff répond à vos questions." # La description de l'embed dans le ticket créé, juste au dessus des champs de questions, utilise {user} pour l'utilisateur comme @User et {user.tag} pour le nom de l'utilisateur sans qu'il soit mentionné comme User
    ticketName: "USERNAME" # Options disponibless: USERNAME (sera comme name-USERNAME pour "report-ralphkb"), TICKETCOUNT (sera comme name-TICKETCOUNT pour "report-12348") or BOTH (sera comme USERNAME-TICKETCOUNT pour "ralphkb-12348")
    ticketTopic: "Créateur du ticket: {user} | Type de ticket: {type}" # La description du ticket (fonctionnalité Discord)
    slowmode: "0" # Le mode lent du canal ticket en secondes, gardez-le à 0 si vous ne souhaitez pas de mode lent et n'utilisez pas de valeurs négatives
    useCodeBlocks: false # Définissez ceci sur true si vous souhaitez utiliser des blocs de code pour afficher les réponses aux questions sur la catégorie de ticket
    modalTitle: "Formulaire de ticket divers" # Le titre du formulaire
    questions: # Le nombre maximum de questions est de 5, vous devez conserver au moins 1 question car cette information vous aidera toujours dans n'importe quel ticket.
      - label: "Quelle est ta question?"
        placeholder: "Écrivez votre question"
        style: "Paragraph" # Short or Paragraph
        required: true # Si cette question est obligatoire ou non, utilisez true pour oui ou false pour non
        minLength: 10 # Définir le nombre minimum de caractères requis pour la réponse

# ==============================================
# Paramètres multi-panel
# ==============================================

panels:
  - id: 1 # ID unique pour chaque panneau
    categories: ["1, 2"] # Les catégories que contiendra le panneau, utilisez les identifiants des catégories ci-dessus, assurez-vous qu'elles sont valides et ne le laissez pas vide
    maxButtonsPerRow: "5" # Le nombre maximum de boutons par ligne. Notez que cela réduira le nombre total de catégories que vous pouvez créer en raison d'une limitation de 5 lignes par message.
    menuPlaceholder: "Sélectionnez une catégorie pour ouvrir un ticket." # L'espace réservé du menu de sélection
    panelEmbed:
      color: "#2FF200"
      title: "Tickets"
      description: "Pour créer un ticket d'assistance, cliquez sur l'un des boutons ci-dessous en fonction de l'aide dont vous avez besoin." # Utilisez \n pour créer une nouvelle ligne pour cette description intégrée si nécessaire
      timestamp: true
      URL: ""
      image: ""
      thumbnail: ""
      footer:
        text: "Sentinel Tickets"
        iconURL: ""
      author:
        name: ""
        iconURL: ""
        url: ""

# ==============================================
# Paramètres concernant l'envoie d'un message privé à l'utilisateur
# ==============================================
# Activez ou désactivez l'envoi d'un message direct à un utilisateur une fois son ticket supprimé.
# Si les 3 options sont définies sur false, aucun DM ne sera envoyé.
DMUserSettings:
  embed: true # Activer ou désactiver l'envoi d'une intégration dans le DM
  transcript: true # Activer ou désactiver l'envoi d'un transcription dans le DM
  ratingSystem:
    enabled: false # Vous pouvez activer le système de notation tout en gardant les 2 options ci-dessus désactivées
    menu:
      emoji: "⭐"
      placeholder: "Selectionnez une note"
    modalTitle: "Commentaires sur les tickets"
    questions: # Le nombre maximum de questions est de 5, vous devez en conserver au minimum 1 pour utiliser cette fonctionnalité
      - label: "Quel est votre commentaire ?"
        placeholder: "Écrivez votre commentaire ici"
        style: "Paragraph" # Short or Paragraph
        required: true # Si cette question est obligatoire ou non, utilisez true pour oui ou false pour non
        minLength: 80 # Définir le nombre minimum de caractères requis pour la soumission

# ==============================================
# Paramètres des commandes Slash
# ==============================================

# Vous pouvez désactiver une commande en définissant: false pour chacune d'entre elles, bien qu'il soit recommandé de les laisser toutes activées.
# Pour plus d'informations sur les options dont vous disposez en tant que permissions pour chaque commande, consultez ce lien: https://discord-api-types.dev/api/discord-api-types-payloads/common#PermissionFlagsBits
commands:
  add:
    enabled: true
    permission: "KickMembers"
    pingUser: false # Ping le nouveau utilisateur qui est rajouté
  alert:
    enabled: true
    permission: "KickMembers"
  transcript:
    enabled: true
    permission: "KickMembers"
  claim:
    enabled: true
    permission: "KickMembers"
  unclaim:
    enabled: true
    permission: "KickMembers"
  move:
    enabled: true
    permission: "KickMembers"
    updateTopic: true
  transfer:
    enabled: true
    permission: "KickMembers"
    pingUser: false # Ping le nouveau créateur du ticket
    updateTopic: true # Mettre à jours la description du ticket (fonctionnalité discord)
  pin:
    enabled: true
    permission: "KickMembers"
    emoji: "📌"
    alreadyPinned: "Ce ticket est déjà épinglé !"
  priority:
    enabled: true
    permission: "KickMembers"
    emojis:
      low: "🟢"
      medium: "🟡"
      high: "🔴"
    alreadyPriority: "Ce ticket est déjà prioritaire !"
    notPriority: "Ce ticket n'est pas prioritaire!"
  slowmode:
    enabled: true
    permission: "KickMembers"
    alreadySlowmode: "Ce ticket a déjà ce mode lent."
    slowmodeRemoved: "Le mode lent a été supprimé de ce ticket."
  close:
    enabled: true
    permission: "KickMembers"
  closerequest:
    enabled: true
    permission: "ViewChannel"
    pingRoles: false # Activez ou désactivez le mention des rôles de support de la catégorie de ticket où la commande est utilisée, aucun rôle ne sera pingé si la catégorie ping_role_ids est vide.
  reopen:
    enabled: true
    permission: "KickMembers"
  delete:
    enabled: true
    permission: "KickMembers"
  panel:
    enabled: true
    permission: "ManageChannels"
    support_role_ids: [] # Les ID des rôles du Staff sur votre serveur qui peuvent utiliser la commande panel, ils doivent également avoir l'autorisation ci-dessus, gardez-la vide pour ne pas nécessiter de rôle.
  remove:
    enabled: true
    permission: "KickMembers"
  rename:
    enabled: true
    permission: "KickMembers"
  blacklist:
    enabled: true
    permission: "KickMembers"
  unblacklist:
    enabled: true
    permission: "KickMembers"
  ping:
    enabled: true
    permission: "KickMembers"
  stats:
    enabled: true
    permission: "KickMembers"
  help:
    enabled: true
    permission: "KickMembers"
  preference:
    enabled: false
    permission: "ViewChannel"

contextMenuCommands:
  userInfo:
    enabled: true
    permission: "KickMembers"
  blacklistAdd:
    enabled: true
    permission: "KickMembers"
  blacklistRemove:
    enabled: true
    permission: "KickMembers"
  ticketAlert:
    enabled: true
    permission: "KickMembers"
  ticketPin:
    enabled: true
    permission: "KickMembers"
  ticketTranscript:
    enabled: true
    permission: "KickMembers"

# ==============================================
# Paramètres généraux des boutons
# ==============================================
# If you intend to use the allowedRoles options in this section, you should probably disable reOpenStaffOnly, closeStaffOnly & deleteStaffOnly at the top of the configuration because otherwise the users will require both the below allowed roles & the support role of a ticket category.

closeButton:
  label: "Fermer" # Le nom du boutton
  emoji: "🔒" # L'émoji du button
  style: "Danger" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"
  allowedRoles: [] # The IDs of the roles that can use the close button, keep it empty to not require a role

reOpenButton:
  label: "Rouvrir" # Le nom du boutton
  emoji: "🔓" # L'émoji du button
  style: "Success" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"
  allowedRoles: [] # The IDs of the roles that can use the reopen button, keep it empty to not require a role

transcriptButton:
  label: "Transcript" # Le nom du boutton
  emoji: "📝" # L'émoji du button
  style: "Primary" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"

deleteButton:
  label: "Supprimer" # Le nom du boutton
  emoji: "⛔" # L'émoji du button
  style: "Danger" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"
  allowedRoles: [] # The IDs of the roles that can use the delete button, keep it empty to not require a role

claimButton:
  label: "Réclamer" # Le nom du boutton
  emoji: "👋" # L'émoji du button
  style: "Success" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"

unclaimButton:
  label: "Abandonner" # Le nom du boutton
  emoji: "👋" # L'émoji du button
  style: "Danger" # Options: "Primary" pour la couleur bleu, "Secondary" pour du gris, "Success" pour du vert, "Danger" pour du rouge mais n'UTILISEZ PAS "Link"

newTicketButton:
  label: "Cliquez ici" # Le nom du boutton
  emoji: "🎫" # L'émoji du button

# ==============================================
# Paramètres des heures de travail
# ==============================================

# Note: si le système des heures de travail ne fonctionne pas, cela est probablement dû à une mauvaise configuration des heures min et max.
workingHours:
  enabled: false # Activer ou désactiver la fonctionnalité des heures de travail
  timezone: "Europe/Paris" # Le fuseau horaire des heures de travail, les options sur ce lien devraient fonctionner : https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
  default: # Les heures de travail par défaut pour tout jour non spécifié ci-dessous
    min: "09:00"
    max: "17:00"
    blockTicketCreation: true
  days:
    - day: "monday" # Le jour de la semaine, les options sont "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"
      min: "09:00" # L'heure minimum, veillez à utiliser le format 24 heures HH:MM, exemples : 00:59, 05:00, 17:00, 23:59 n'oubliez pas d'inclure le premier 0.
      max: "17:00" # L'heure maximum, veillez à utiliser le format 24 heures HH:MM, exemples : 00:59, 05:00, 17:00, 23:59 n'oubliez pas d'inclure le premier 0.
      blockTicketCreation: true # Activer ou désactiver le blocage de la création de tickets en dehors des heures ouvrées
    - day: "tuesday"
      min: "09:00"
      max: "17:00"
      blockTicketCreation: true
    - day: "wednesday"
      min: "09:00"
      max: "17:00"
      blockTicketCreation: true
    - day: "thursday"
      min: "09:00"
      max: "17:00"
      blockTicketCreation: true
    - day: "friday"
      min: "09:00"
      max: "17:00"
      blockTicketCreation: true
    - day: "saturday"
      min: "09:00"
      max: "12:00"
      blockTicketCreation: true
    - day: "sunday"
      min: "09:00"
      max: "12:00"
      blockTicketCreation: true
  outsideWarning: true # Si les heures de travail sont activées, cette option activera ou désactivera l'avertissement intégré lorsqu'un ticket est créé en dehors des heures de travail.
  addField: true # Si les heures de travail sont activées, cette option activera ou désactivera l'ajout du champ des heures de travail à l'intégration de création de ticket.
  fieldTitle: "Heure de travail" # Le titre du champ Horaires de travail
  valueDays: "TODAY" # Options disponibles: "TODAY" qui affichera uniquement les heures de travail d'aujourd'hui ou "ALL" qui affichera les heures de travail configurées pour chaque jour
  fieldValue: "> {day}: {openingTime} jusqu'à {closingTime}" # La valeur de chaque champ d'heures de travail, utilisez {day} pour le jour de la semaine d'aujourd'hui, {openingTime} pour l'heure d'ouverture et {closingTime} pour l'heure de fermeture.

# L'embed qui est envoyé lorsque la création du ticket est bloquée car elle est en dehors des heures de travail
workingHoursEmbed:
  color: "#FF0000"
  title: "Heure de travail"
  description: "Les tickets ne sont ouverts qu'entre {openingTime} et {closingTime}.\nL'heure actuelle est {now}." # Le message affiché lorsque la création du ticket est bloquée, utilisez {openingTime} pour l'heure d'ouverture, {closingTime} pour l'heure de fermeture et {now} pour l'heure actuelle
  timestamp: true
  URL: ""
  image: ""
  thumbnail: ""
  footer:
    text: ""
    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

# L'embed envoyé lorsqu'un ticket est créé en dehors des heures de travail
outsideWorkingHoursEmbed:
  color: "#FF0000"
  title: "En dehors des heures de travail"
  description: "Vous avez créé un ticket en dehors de nos heures de travail. Veuillez noter que notre délai de réponse peut être retardé.\nNos heures de travail pour aujourd'hui sont de {openingTime} à {closingTime}." # Utilisez {openingTime} pour l'heure d'ouverture, {closingTime} pour l'heure de fermeture.
  timestamp: true
  URL: ""
  image: ""
  thumbnail: ""
  footer:
    text: ""
    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

# ==============================================
# Salon de logs
# ==============================================

# Dans cette section, vous pouvez activer/désactiver certains logs. Par défaut, tous les logs sont activés
toggleLogs:
  userAdd: true
  userRemove: true
  ticketCreate: true
  ticketClose: true
  ticketReopen: true
  ticketDelete: true
  ticketClaim: true
  ticketUnclaim: true
  ticketMove: true
  ticketRename: true
  ticketTransfer: true
  ticketPin: true
  ticketSlowmode: true
  ticketPriority: true
  ticketFeedback: true
  DMErrors: true
  blacklistAdd: true
  blacklistRemove: true

# Cette section vous permet de configurer les salons sur lesquels le bot enverra différents logs. Assurez-vous de configurer au moins le canal de logs par défaut.
# En laissant un canal vide "", le bot reviendra au canal de journalisation par défaut.
logs:
  default: "111111111111111111" # L'ID du salon de logs par défaut
  transcripts: "111111111111111111" # L'ID du salon de logs pour les transcriptions manuelles obtenues avec le bouton ou la commande de transcription
  userAdd: ""
  userRemove: ""
  ticketCreate: ""
  ticketClose: ""
  ticketReopen: ""
  ticketDelete: ""
  ticketClaim: ""
  ticketUnclaim: ""
  ticketMove: ""
  ticketRename: ""
  ticketTransfer: ""
  ticketPin: ""
  ticketSlowmode: ""
  ticketPriority: ""
  ticketFeedback: ""
  DMErrors: ""
  blacklistAdd: ""
  blacklistRemove: ""

# ==============================================
# Embeds Locale
# ==============================================

# NOTE: Lors de la configuration des options d'intégration, vous pouvez la laisser sous vide pour ne pas utiliser l'option ou la définir comme vous le souhaitez.
# Les options telles que la couleur et la description peuvent revenir à une valeur par défaut, sinon une erreur serait générée dans certains cas.
# En supprimant entièrement une option de cette partie de la configuration, le bot tentera de revenir à une valeur par défaut, sinon il ignorera l'option.
# Par exemple, si vous supprimez l’option thumbnail, le bot utilisera la thumbnail par défaut si elle est disponible, sinon aucune thumbnail ne sera ajoutée.

# L'intégration envoyée lors de la création d'un nouveau ticket, avec les questions incluses
# Pour cette intégration, les options que vous ne trouvez pas ici sont probablement uniques à chaque catégorie et configurées dans les paramètres de catégorie ci-dessus.
ticketOpenEmbed:
  title: "" # Gardez-le vide pour utiliser le champ auteur comme titre en fonction de votre titre configuré dans les paramètres de la catégorie.
