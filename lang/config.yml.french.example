  author:
    name: ""
    iconURL: ""
    url: ""

# L'intégration qui est envoyé dans un salon lorsque le bot ne parvient pas à envoyer un DM à un utilisateur
dmErrorEmbed:
  pingUser: false # Ping à l'utilisateur, le bot n'a pas réussi à DM
  color: "#FF0000"
  title: "DM désactivés"
  description: "Le bot n'a pas pu envoyer de message privé à **{user} ({user.tag})** car ses DM étaient fermés.\nVeuillez activer « Autoriser les messages directs » sur ce serveur pour recevoir plus d'informations du bot !\n\nPour obtenir de l'aide, veuillez lire [cet article](https://support.discord.com/hc/en-us/articles/217916488-Blocking-Privacy-Settings).
" # Vous pouvez utiliser {user} pour l'utilisateur auquel le bot n'a pas réussi à envoyer un DM et {user.tag} pour le tag de l'utilisateur
  timestamp: true
  URL: ""
  image: ""
#  thumbnail: ""
#  footer:
#    text: ""
#    iconURL: ""
  author:
    name: ""
    iconURL: ""
    url: ""

